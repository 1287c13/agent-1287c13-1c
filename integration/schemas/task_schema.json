{
  "type": "object",
  "required": [
    "id",
    "created_at",
    "source",
    "mode",
    "role",
    "action",
    "prompt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^t-[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "http",
        "cli"
      ]
    },
    "client": {
      "type": "string",
      "maxLength": 120
    },
    "mode": {
      "type": "string",
      "enum": [
        "db",
        "harness"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "action": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2000
    },
    "db": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "goal": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2000
    },
    "prompt": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4000
    },
    "deliver": {
      "type": "string",
      "enum": [
        "uri",
        "manual",
        "echo",
        "auto"
      ]
    },
    "timeout_s": {
      "type": "integer"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  }
}
